# Copy to .env and adjust for your environment. Every value here has a
# local-dev fallback baked into server.js/worker.js, so the app runs with
# zero setup even without a .env file — this is only needed to override
# those defaults (and required before deploying anywhere real).

# --- Database (must match whatever ran verify.sh / the migrations) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learner_registration_database
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---
# Generate a real one before deploying anywhere real, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=4000

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API from
# a browser. Defaults to the dev scaffold's own origin if unset — that
# is NOT a real domain, so it must be set before deploying anywhere real
# (e.g. CORS_ORIGIN=https://app.ascskillsconnect.co.za). Requests with
# no Origin header (curl, server-to-server) are unaffected either way.
CORS_ORIGIN=http://localhost:5173

# --- Notifications (see notifier.js) ---
# Only 'console' exists right now — logs to stdout, does not send
# anything externally. A real provider (SendGrid, Twilio, etc.) would be
# added as a new entry in notifier.js's PROVIDERS map.
NOTIFICATION_PROVIDER=console
